# For local development with docker compose, copy this file to .env
# (docker-compose.yml already has default values for local dev; this file
# is the reference for when you deploy outside of Docker or to prod).

DATABASE_URL="postgresql://rastreo_tracker:rastreo_tracker_dev@localhost:5434/rastreo_tracker"

# Generate a unique secret with: openssl rand -base64 32
# Used to sign the admin/consulta session cookie.
AUTH_SECRET="CHANGE_THIS_VALUE"

# Initial admin PIN, used ONLY by the seed script to create the first
# hashed PIN in the database. Change it by generating a new bcrypt hash
# and updating the Settings.adminPinHash row directly (see README).
ADMIN_PIN="2468"
